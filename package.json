{
  "name": "jilowa-discord",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/server & npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/server",
    "db:push": "npm run db:push -w apps/server",
    "db:migrate": "npm run db:migrate -w apps/server"
  },
  "dependencies": {
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "effect": "4.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "8.0.0-rc.33"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5"
  }
}
